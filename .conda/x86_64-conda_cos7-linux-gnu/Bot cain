#!/usr/bin/env python3
"""
Benchmark script untuk blockchain performance
"""

import time
import sys
import os
sys.path.append(os.path.join(os.path.dirname(__file__), '..', 'src'))

from src.blockchain.blockchain import Blockchain
from src.blockchain.transaction import Transaction
from src.utils.config import Config

def benchmark_mining():
    """Benchmark mining performance"""
    print("⛏️ MINING BENCHMARK")
    print("=" * 40)
    
    difficulties = [2, 3, 4, 5]
    results = {}
    
    for difficulty in difficulties:
        print(f"\nTesting difficulty {difficulty}...")
        
        config = Config()
        config.set('difficulty', difficulty)
        blockchain = Blockchain(config)
        
        # Tambah transaksi dummy
        tx = Transaction("Alice", "Bob", 10.0, 0.1)
        blockchain.add_transaction(tx)
        
        # Ukur waktu mining
        start_time = time.time()
        block = blockchain.mine_pending_transactions("miner")
        end_time = time.time()
        
        mining_time = end_time - start_time
        results[difficulty] = {
            'time': mining_time,
            'nonce': block.nonce if block else 0,
            'hash': block.hash if block else None
        }
        
        print(f"  Time: {mining_time:.2f}s")
        print(f"  Nonce: {block.nonce:,}")
        print(f"  Hash: {block.hash[:20]}...")
    
    # Tampilkan hasil
    print(f"\n📊 RESULTS:")
    for difficulty, result in results.items():
        print(f"Difficulty {difficulty}: {result['time']:.2f}s ({result['nonce']:,} attempts)")

def benchmark_transactions():
    """Benchmark transaction processing"""
    print("\n💸 TRANSACTION BENCHMARK")
    print("=" * 40)
    
    config = Config()
    blockchain = Blockchain(config)
    
    # Test berbagai jumlah transaksi
    tx_counts = [10, 50, 100, 500]
    
    for count in tx_counts:
        print(f"\nTesting {count} transactions...")
        
        # Buat transaksi
        start_time = time.time()
        for i in range(count):
            tx = Transaction(f"sender_{i}", f"receiver_{i}", 1.0, 0.001)
            blockchain.add_transaction(tx)
        
        creation_time = time.time() - start_time
        
        # Mine blok
        start_time = time.time()
        block = blockchain.mine_pending_transactions("miner")
        mining_time = time.time() - start_time
        
        print(f"  Creation: {creation_time:.3f}s ({count/creation_time:.0f} tx/s)")
        print(f"  Mining: {mining_time:.2f}s")
        print(f"  Block size: {len(str(block.to_dict()))} bytes")

if __name__ == "__main__":
    benchmark_mining()
    benchmark_transactions()

