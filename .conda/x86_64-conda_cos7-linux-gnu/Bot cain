import json
import time
from typing import List, Dict, Any, Optional
from .block import Block
from .transaction import Transaction

class Blockchain:
    """Kelas utama blockchain"""
    
    def __init__(self, config):
        self.config = config
        self.chain: List[Block] = []
        self.pending_transactions: List[Transaction] = []
        self.mining_reward = config.get('mining_reward', 100)
        self.difficulty = config.get('difficulty', 4)
        
        # Buat genesis block
        self.create_genesis_block()
    
    def create_genesis_block(self) -> Block:
        """Buat blok pertama (genesis)"""
        genesis_transactions = []
        genesis_block = Block(0, genesis_transactions, "0" * 64, self.difficulty)
        genesis_block.mine_block()
        self.chain.append(genesis_block)
        return genesis_block
    
    def get_latest_block(self) -> Block:
        """Ambil blok terakhir"""
        return self.chain[-1]
    
    def add_transaction(self, transaction: Transaction) -> bool:
        """Tambah transaksi ke pending pool"""
        if not transaction.is_valid():
            return False
        
        self.pending_transactions.append(transaction)
        return True
    
    def mine_pending_transactions(self, mining_reward_address: str) -> Optional[Block]:
        """Mine semua transaksi pending"""
        # Tambah reward transaksi untuk miner
        reward_transaction = Transaction(
            sender="System",
            receiver=mining_reward_address,
            amount=self.mining_reward,
            fee=0
        )
        
        transactions_to_mine = self.pending_transactions.copy()
        transactions_to_mine.append(reward_transaction)
        
        # Buat blok baru
        block = Block(
            index=len(self.chain),
            transactions=transactions_to_mine,
            previous_hash=self.get_latest_block().hash,
            difficulty=self.difficulty
        )
        
        # Mine blok
        success = block.mine_block()
        if success:
            self.chain.append(block)
            self.pending_transactions = []  # Reset pending transactions
            return block
        
        return None
    
    def is_chain_valid(self) -> bool:
        """Validasi seluruh blockchain"""
        for i in range(1, len(self.chain)):
            current_block = self.chain[i]
            previous_block = self.chain[i - 1]
            
            if not current_block.is_valid(previous_block):
                return False
        
        return True
    
    def get_balance(self, address: str) -> float:
        """Hitung saldo address"""
        balance = 0
        
        for block in self.chain:
            for transaction in block.transactions:
                if transaction.sender == address:
                    balance -= (transaction.amount + transaction.fee)
                
                if transaction.receiver == address:
                    balance += transaction.amount
        
        return balance
    
    def get_transaction(self, tx_id: str) -> Optional[Transaction]:
        """Cari transaksi berdasarkan ID"""
        for block in self.chain:
            for transaction in block.transactions:
                if transaction.tx_id == tx_id:
                    return transaction
        
        return None
    
    def get_stats(self) -> Dict[str, Any]:
        """Ambil statistik blockchain"""
        total_transactions = sum(len(block.transactions) for block in self.chain)
        
        return {
            'total_blocks': len(self.chain),
            'total_transactions': total_transactions,
            'pending_transactions': len(self.pending_transactions),
            'difficulty': self.difficulty,
            'is_valid': self.is_chain_valid(),
            'latest_block_hash': self.get_latest_block().hash
        }
    
    def to_dict(self) -> Dict[str, Any]:
        """Konversi blockchain ke dictionary"""
        return {
            'chain': [block.to_dict() for block in self.chain],
            'pending_transactions': [tx.to_dict() for tx in self.pending_transactions],
            'stats': self.get_stats()
        }

