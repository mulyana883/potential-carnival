import hashlib
import json
import time
from typing import List, Dict, Any, Optional
from .transaction import Transaction

class Block:
    """Blok dalam blockchain"""
    
    def __init__(self, index: int, transactions: List[Transaction], 
                 previous_hash: str, difficulty: int = 4, timestamp: Optional[float] = None):
        # Header
        self.index = index
        self.timestamp = timestamp or time.time()
        self.previous_hash = previous_hash
        self.difficulty = difficulty
        self.nonce = 0
        
        # Body
        self.transactions = transactions
        self.transaction_count = len(transactions)
        self.merkle_root = self.calculate_merkle_root()
        
        # Hash akan diisi saat mining
        self.hash = None
    
    def calculate_merkle_root(self) -> str:
        """Hitung merkle root dari semua transaksi"""
        if not self.transactions:
            return hashlib.sha256("".encode()).hexdigest()
        
        tx_hashes = [tx.tx_id for tx in self.transactions]
        
        # Pastikan jumlah hash genap
        if len(tx_hashes) % 2 != 0:
            tx_hashes.append(tx_hashes[-1])
        
        while len(tx_hashes) > 1:
            next_level = []
            for i in range(0, len(tx_hashes), 2):
                combined = tx_hashes[i] + tx_hashes[i + 1]
                next_level.append(hashlib.sha256(combined.encode()).hexdigest())
            tx_hashes = next_level
        
        return tx_hashes[0]
    
    def calculate_hash(self) -> str:
        """Hitung hash blok"""
        block_string = f"{self.index}{self.timestamp}{self.previous_hash}{self.merkle_root}{self.nonce}{self.difficulty}"
        return hashlib.sha256(block_string.encode()).hexdigest()
    
    def mine_block(self) -> bool:
        """Mine blok menggunakan Proof of Work"""
        target = "0" * self.difficulty
        
        while True:
            self.hash = self.calculate_hash()
            
            if self.hash.startswith(target):
                return True
            
            self.nonce += 1
    
    def is_valid(self, previous_block: Optional['Block'] = None) -> bool:
        """Validasi blok"""
        # Cek hash
        if self.hash != self.calculate_hash():
            return False
        
        # Cek difficulty
        if not self.hash.startswith("0" * self.difficulty):
            return False
        
        # Cek previous hash
        if previous_block and self.previous_hash != previous_block.hash:
            return False
        
        # Cek merkle root
        if self.merkle_root != self.calculate_merkle_root():
            return False
        
        return True
    
    def to_dict(self) -> Dict[str, Any]:
        """Konversi ke dictionary"""
        return {
            'index': self.index,
            'timestamp': self.timestamp,
            'previous_hash': self.previous_hash,
            'hash': self.hash,
            'merkle_root': self.merkle_root,
            'nonce': self.nonce,
            'difficulty': self.difficulty,
            'transaction_count': self.transaction_count,
            'transactions': [tx.to_dict() for tx in self.transactions]
        }

